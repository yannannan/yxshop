# Windows 与 Linux 使用同一套业务数据时填写相同的数据库地址与账号。
MYSQL_HOST=8.153.76.20
MYSQL_PORT=3306
MYSQL_DATABASE=yxshop
MYSQL_USER=yxshop
MYSQL_PASSWORD=replace-with-your-password

# 可选：留空或不可用时，登录验证码会自动降级为演示码 888888。
SMS_API_URL=http://127.0.0.1:9268/api/sms/send
# 生产环境请设置随机长字符串，用于加密保存登录验证码。
AUTH_CODE_SECRET=replace-with-a-random-long-secret

# 工具独立页面、canonical、sitemap 使用的正式域名。
NEXT_PUBLIC_SITE_URL=https://www.yxstar.shop

# 可选：外部积分工具成功回调的服务端密钥，至少 32 个随机字符，仅服务端持有。
# 内置印章无需配置；未配置时外部积分工具入口不会开放。
TOOLS_USAGE_SECRET=
