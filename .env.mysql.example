# Windows 与 Linux 使用同一套业务数据时填写相同的数据库地址与账号。
MYSQL_HOST=8.153.76.20
MYSQL_PORT=3306
MYSQL_DATABASE=yxshop
MYSQL_USER=yxshop
MYSQL_PASSWORD=replace-with-your-password

# 可选：留空或不可用时，登录验证码会自动降级为演示码 888888。
SMS_API_URL=http://127.0.0.1:9268/api/sms/send
# 生产环境请设置随机长字符串，用于加密保存登录验证码。
AUTH_CODE_SECRET=replace-with-a-random-long-secret

# 工具独立页面、canonical、sitemap 使用的正式域名。
NEXT_PUBLIC_SITE_URL=https://www.yxstar.shop

# 可选：外部积分工具成功回调的服务端密钥，至少 32 个随机字符，仅服务端持有。
# 内置印章及链接视频提取无需配置此密钥；未配置时外部积分工具入口不会开放。
TOOLS_USAGE_SECRET=

# 视频平台引擎：默认使用项目 vendor/video-engine 内的 yt-dlp(.exe)、ffmpeg(.exe)。
# node scripts/setup-video-engine.mjs 安装 yt-dlp；B站等分离音视频画质需要 FFmpeg。
# 可填写绝对路径，或相对于项目根目录的路径；留空时采用默认路径。
VIDEO_YTDLP_PATH=
VIDEO_FFMPEG_PATH=
# 抖音及动态网页的后端解析引擎。先执行 node scripts/setup-video-engine.mjs --browser。
# 留空使用项目安装记录；如指定路径，请使用兼容系统的 Chromium Headless Shell。
# CentOS 可执行 bash scripts/install-video-deps-centos.sh，自动记录兼容的 Firefox 引擎。
# 如显式填写 Firefox 路径，同时设置 VIDEO_BROWSER_ENGINE=firefox；留空优先使用安装记录。
VIDEO_BROWSER_PATH=
VIDEO_BROWSER_ENGINE=
VIDEO_BROWSER_ENABLED=1
# 单个任务下载总量上限，20–1024 MB，默认 200。
VIDEO_MAX_FILE_MB=200

# 视频成品长期保存到阿里云 OSS；上传校验及数据库保存成功后立即删除本地副本。
# 默认 oss；未配好时禁止创建新提取任务，不会自动退回本地长期保存。
VIDEO_STORAGE_DRIVER=oss
VIDEO_OSS_BUCKET=yxstarshop
VIDEO_OSS_REGION=oss-cn-shanghai
VIDEO_OSS_PREFIX=yxshop/video-extractions
# 仅填写在服务器环境文件，勿提交真实密钥或发到聊天。
VIDEO_OSS_ACCESS_KEY_ID=
VIDEO_OSS_ACCESS_KEY_SECRET=
# 使用临时 STS 凭据时填写；静态 RAM AccessKey 留空。
VIDEO_OSS_STS_TOKEN=
# 上海地域 ECS 可改 1 使用内网上传；用户下载始终使用公网 HTTPS。
VIDEO_OSS_INTERNAL_UPLOAD=0
