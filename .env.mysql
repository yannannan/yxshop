# 视频成品长期保存到上海 OSS，上传校验及保存成功后自动删除本地副本。
# 只需填写 VIDEO_OSS_ACCESS_KEY_ID 和 VIDEO_OSS_ACCESS_KEY_SECRET；不要提交真实密钥。
VIDEO_STORAGE_DRIVER=oss
VIDEO_OSS_BUCKET=yxstarshop
VIDEO_OSS_REGION=oss-cn-shanghai
VIDEO_OSS_PREFIX=yxshop/video-extractions
# 【需要填写】RAM AccessKey ID
VIDEO_OSS_ACCESS_KEY_ID=
# 【需要填写】RAM AccessKey Secret
VIDEO_OSS_ACCESS_KEY_SECRET=
# 使用普通 RAM AccessKey 时，此项留空。
VIDEO_OSS_STS_TOKEN=
VIDEO_OSS_INTERNAL_UPLOAD=0
